# ==============================================================================
# CT-200 Document Intelligence & QA Traceability — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Mode 1: Built-in Offline Mode (Default)
# ------------------------------------------------------------------------------
# No configuration needed! If OPENAI_API_KEY is not set, the service runs
# completely offline using a deterministic rule-based grounded synthesizer that
# extracts actual numbers, error codes, and pressure thresholds from the manual.

# ------------------------------------------------------------------------------
# Mode 2: OpenAI Provider
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key
# LLM_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Mode 3: Google Gemini (via OpenAI-Compatible Endpoint)
# ------------------------------------------------------------------------------
# Gemini does not use proprietary SDK calls in this project. Instead, it connects
# via Google's official OpenAI-compatible endpoint.
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Mode 4: Local LLMs (Ollama / vLLM / LM Studio)
# ------------------------------------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3.1
